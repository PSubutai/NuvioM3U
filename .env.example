# NuvioM3U configuration
#
# Copy to .env and edit. .env is gitignored; this example file is not.
#
#   cp .env.example .env
#
# docker compose reads .env from this directory automatically.
# For local development the app does not load .env on its own - use:
#
#   node --env-file=.env --watch src/index.ts
#
# ---------------------------------------------------------------------------

# HTTP port for both the admin UI and the addon manifests.
PORT=7000

# Where the SQLite database lives.
#
# This file holds Xtream provider passwords in plaintext, M3U URLs containing
# IPTV credentials, and every list slug. Treat it, and any backup of it, as a
# secret. Inside Docker leave this at the default so it lands on the /config
# volume; for local development point it somewhere writable, e.g.
# ./config/nuviom3u.db
DB_PATH=/config/nuviom3u.db

# Public origin this is reachable on, with no trailing slash.
#
# SET THIS whenever a reverse proxy (Pangolin, Traefik, nginx) sits in front.
# Without it the admin UI generates manifest URLs pointing at the container's
# internal address; they install without error and then show an empty list.
# This is the single most common misconfiguration.
PUBLIC_URL=https://m3u.example.com

# Trust X-Forwarded-Proto and X-Forwarded-Host. Leave true behind a proxy.
# Only used as a fallback when PUBLIC_URL is unset.
TRUST_PROXY=true

# Password for the admin UI. Leave blank or unset for no password.
#
# Blank is only safe if something else authenticates in front AND nothing can
# reach the container directly, because the admin UI displays your provider
# credentials in full.
#
# Note this protects the admin UI only. The /s/<slug>/ addon routes are always
# open - Stremio and Nuvio cannot sign in - which is why each manifest URL
# carries an unguessable random slug instead. If you publish through Pangolin,
# do NOT enable its SSO on this resource; set a password here instead.
ADMIN_PASSWORD=

# Probe every stream URL on this interval, in minutes. 0 disables automatic
# checks; you can always check on demand from the admin UI.
HEALTHCHECK_INTERVAL_MINUTES=0

# Ownership of files in /config, read by the container entrypoint.
# 99:100 is nobody:users, the Unraid default.
PUID=99
PGID=100

# Container timezone, used for timestamps shown in the admin UI.
TZ=Etc/UTC
